{
  "permissions": {
    "deny": [
      "node_modules/**",
      "app/node_modules/**",
      ".next/**",
      "app/.next/**",
      "dist/**",
      "build/**",
      "coverage/**",
      "package-lock.json",
      "npm-shrinkwrap.json",
      "yarn.lock",
      "pnpm-lock.yaml",
      ".env",
